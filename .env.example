# API key for whichever provider you use (you can also set these at runtime
# with the /provider command, which saves them to .termchat.json).
CEREBRAS_API_KEY=your-cerebras-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
FIREWORKS_API_KEY=your-fireworks-api-key-here

# Optional, for web search (/search, /deepsearch, and automatic tool calls).
TAVILY_API_KEY=your-tavily-api-key-here
